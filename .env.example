# =====================================================
# Google Health API (Recommended — replaces Fitbit)
# =====================================================
# Fitbit Web API shuts down Oct 30, 2026.
# The Google Health API is the official replacement.
#
# Setup:
#  1. Go to https://console.cloud.google.com/
#  2. Enable "Google Health API" on the API Library page
#  3. Create OAuth 2.0 Web credentials
#  4. Add redirect URI: http://localhost:5173
#  5. Add test users on the OAuth Audience page
#  6. Install Google Health app on your phone & link account
#
# Docs: https://developers.google.com/health/setup

VITE_GHEALTH_CLIENT_ID=YOUR_GOOGLE_HEALTH_CLIENT_ID.apps.googleusercontent.com
VITE_GHEALTH_REDIRECT_URI=http://localhost:5173

# =====================================================
# Legacy Google Fit API (deprecated — avoid for new projects)
# =====================================================
# Google Fit is being phased out. Use Google Health above.

VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_FIT_CLIENT_ID.apps.googleusercontent.com
